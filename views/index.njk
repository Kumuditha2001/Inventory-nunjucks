{% extends "layout.njk" %}

{% block content %}

<h1>Inventory Management System CI/CD testing</h1>

<a href="/add" class="btn btn-primary mb-3">
    Add Item
</a>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Category</th>
        <th>Action</th>
    </tr>

    {% for item in items %}
    <tr>
        <td>{{ item.name }}</td>
        <td>{{ item.price }}</td>
        <td>{{ item.stock }}</td>
        <td>{{ item.category }}</td>
        <td>
            <a href="/edit/{{ item._id }}" class="btn btn-warning btn-sm">Edit</a>

            <a href="/delete/{{ item._id }}" class="btn btn-danger btn-sm">
                Delete
            </a>
        </td>
    </tr>
    {% endfor %}
</table>

{% endblock %}